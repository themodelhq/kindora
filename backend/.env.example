# ============================================================
# KINDORA API - Environment template
# Copy to .env for local development. NEVER commit a real .env.
# Each variable is documented in docs/ENVIRONMENT_VARIABLES.md
# ============================================================

# ---------- Core ----------
NODE_ENV=development
PORT=10000
APP_NAME=KINDORA
API_PREFIX=api/v1
BACKEND_URL=http://localhost:10000
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# live = real payment providers | mock = deterministic in-process providers (tests / offline dev)
PROVIDER_MODE=live

# ---------- Database (Render PostgreSQL) ----------
DATABASE_URL=postgresql://kindora:password@localhost:5432/kindora

# ---------- Redis (queues, cache, distributed locks) ----------
# Optional locally: when empty, jobs execute inline and caching is disabled.
REDIS_URL=

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30
SESSION_SECRET=change-me-too

# ---------- Seeding / production bootstrap ----------
# REQUIRED for `npm run prisma:seed` (dev/test only). No default exists on purpose.
SEED_ADMIN_PASSWORD=
# Set to 1 to insert demonstration campaigns/donations (dev/demo only).
SEED_DEMO=
# Production administrator creation: npm run bootstrap:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Withdrawals ----------
# Payouts at/above this minor-unit amount require a second admin approval (0 = disabled).
WITHDRAWAL_DUAL_APPROVAL_THRESHOLD_MINOR=0

# ---------- Money / fees ----------
DEFAULT_CURRENCY=NGN
# Optional platform fee percent charged on withdrawals (0 = free platform, tip-based model)
PLATFORM_FEE_PERCENT=0

# ---------- Object storage (S3-compatible: Render Object Storage, R2, B2, MinIO...) ----------
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=
# Max upload size in MB for campaign images
STORAGE_MAX_UPLOAD_MB=15

# ---------- Email (any SMTP provider: Resend, Postmark, Mailgun, SES SMTP...) ----------
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM_ADDRESS=no-reply@kindora.com
EMAIL_FROM_NAME=KINDORA

# ---------- SMS (optional; any provider exposing a REST gateway) ----------
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=KINDORA

# ---------- Payment providers ----------
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# ---------- Push notifications (Web Push / VAPID) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@kindora.com

# ---------- AI (any OpenAI-compatible chat completions endpoint) ----------
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini

# ---------- Monitoring ----------
SENTRY_DSN=

# ---------- Payout authorization & recovery (v1.0.8) ----------
# Outbox lease window (minutes): a claimed IN_FLIGHT intent is owned only until
# the lease expires; recovery reclaims expired leases through the SAFE path
# (provider lookup by reference BEFORE any resubmission).
PAYOUT_OUTBOX_LEASE_MINUTES=10
# Flutterwave mobile-money payouts: DISABLED by default. The beneficiary
# verification implementation ships in v1.0.8; set true ONLY after the
# provider sandbox verification suite for the channel has passed.
PAYOUT_FLW_MOBILE_MONEY_ENABLED=false
