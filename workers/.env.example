# ============================================================
# KINDORA Workers — environment template
# Copy to .env for local development. NEVER commit a real .env.
# Deployed as: 1x Render Background Worker (`npm run start:prod`)
#           + 6x Render Cron Jobs (`npm run cron:<name>`)
# ============================================================

# ---------- Database (REQUIRED — same PostgreSQL as the backend) ----------
DATABASE_URL=postgresql://kindora:password@localhost:5432/kindora

# ---------- Redis (REQUIRED — the worker refuses to start without it) ----------
# The backend enqueues BullMQ jobs here; the workers consume them.
# Local dev without Redis works for the backend (inline fallback) but NOT for workers.
REDIS_URL=redis://localhost:6379

# ---------- URLs ----------
# Used by the payments.reconcile job to call backend verification endpoints.
BACKEND_URL=http://localhost:10000
# Used to build clickable links inside emails.
FRONTEND_URL=http://localhost:5173

# ---------- Email (any SMTP provider: Resend, Postmark, Mailgun, SES SMTP...) ----------
# If SMTP_HOST is empty, emails are skipped and logged as EmailLog{status:SKIPPED_NO_SMTP}.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "true" for implicit TLS (port 465), empty/false for STARTTLS (587).
SMTP_SECURE=false
EMAIL_FROM_ADDRESS=no-reply@kindora.com
EMAIL_FROM_NAME=KINDORA

# ---------- Web Push (browser push notifications) ----------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@kindora.com

# ---------- Object storage (S3-compatible: Render Object Storage, R2, B2, MinIO...) ----------
# If unset, media.process-image jobs fail (and retry) — processing requires storage.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=

# ---------- Malware scanning (HTTP virus-scan service, e.g. a ClamAV REST bridge) ----------
# Empty = no scanner: public media (campaign images, avatars) is approved via the
# re-encoding pipeline, but sensitive documents (KYC, expenses) stay QUARANTINED —
# production MUST set this to a scanner endpoint that accepts raw bytes and
# answers {"clean": true|false} or {"verdict": "CLEAN"|"INFESTED"}.
MALWARE_SCAN_ENDPOINT=

# ---------- Operations ----------
# Comma-separated list of admin recipient emails (weekly reports, reconcile alerts).
ADMIN_EMAILS=admin@kindora.com
# Paystack secret — REQUIRED for real recurring charges (cron:recurring-donations
# POSTs transaction/charge_authorization with it). Never logged.
PAYSTACK_SECRET_KEY=
# mock = deterministic in-process providers (dev/tests: recurring charges succeed
# without network, fraud scorer is a no-op). PRODUCTION MUST SET THIS TO live.
PROVIDER_MODE=mock
