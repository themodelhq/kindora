# KINDORA frontend environment template
# Vite variables are PUBLIC (bundled into the browser). Never put secrets here.

VITE_APP_NAME=KINDORA
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:10000
VITE_ENVIRONMENT=development
VITE_DEFAULT_CURRENCY=NGN
VITE_DEFAULT_LANGUAGE=en

# Offline UI preview only. MUST be unset/empty in production builds.
VITE_DEMO_MODE=1
